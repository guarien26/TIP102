def sort_by_parity(nums):
    start = 0
    end = len(nums) - 1

    while start < end:
        if nums[start] % 2 != 0:
            if nums[end] % 2 != 0:
                start+=1
                end-=1
            else:
                nums[start],nums[end] = nums[end],nums[start]
                start+=1
                end-=1
        else:
            start+=1
    
    print(nums)

nums = [0,1,2]
sort_by_parity([1, 3, 2, 4])


nums = [0]
sort_by_parity(nums)