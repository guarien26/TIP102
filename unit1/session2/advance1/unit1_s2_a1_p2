'''
TWO POINTERS
for two pointer data structure approach, you need to define a start and an end,
the code will start when the start overlaps the end, works for odd and even lists
'''

def reverse_list(lst):
    start = 0
    end = len(lst) - 1

    while start < end:
        lst[start],lst[end] = lst[end],lst[start]
        start+=1
        end-=1
    
    return lst



lst = ["pooh", "christopher robin", "piglet", "roo", "eeyore"]
print(reverse_list(lst))